/OperaAgent-Installer.exe
# from vercel.json /OperaAgent-Installer.exe — the installer is rebuilt often and its path
# never changes, so it is released rather than held.
  Cache-Control: no-store
  Vercel-CDN-Cache-Control: no-store
  Content-Type: application/vnd.microsoft.portable-executable
  X-Content-Type-Options: nosniff
