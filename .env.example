# .env - copy to .env (gitignored) for local use; never commit real values.
# @last-edited: 2026-11-14 12:00 UTC+7.
# @title: .env - the environment the local driver, the bridge cloud meter and ops scripts read.
# @state: the bridge cloud URL is the one secret the local meter depends on; everything else is optional.
# @dependencies: none stated.

# Supabase project (see supabase/config.toml for the self-hosted default).

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The local bridge calls OPERA_CLOUD_URL once per session to open the meter and once at close to report it; the one-line cloud call this file previously documented as OPERA_AGENT_MCP_BASE_URL is the same service.

OPERA_CLOUD_URL=https://nenmkmtvjremqphfqnfw.supabase.co/functions/v1/opera-agent-bridge
OPERA_BRIDGE_PORT=9451
OPERA_BRIDGE_DEBUG_FRAMES=
OPERA_BRIDGE_TRUST_MS=

# MCP server allowlist (see hosted/functions/opera-agent-bridge/index.ts).

OPERA_AGENT_MCP_TOKEN=
OPERA_AGENT_MCP_DEVICE_NAME=opera
OPERA_AGENT_MCP_USER_IDS=
OPERA_AGENT_MCP_EMAILS=

# Ops scripts (see scripts/doctor.mjs and docs/operations.md).

SUPABASE_PROJECT_REF=nenmkmtvjremqphfqnfw
OPERA_AGENT_DIAGNOSTIC_BEARER=

# CORS allowlist for edge functions (comma-separated).
# Empty = fail-closed defaults (this extension + the OAuth consent page).

CORS_ALLOWED_ORIGINS=
