# Ops scripts (see scripts/dev/mcp-connection-diagnostics.mjs).

SUPABASE_PROJECT_REF=nenmkmtvjremqphfqnfw
OPERA_AGENT_MCP_BASE_URL=https://nenmkmtvjremqphfqnfw.supabase.co/functions/v1/opera-agent-mcp
OPERA_AGENT_DIAGNOSTIC_BEARER=

# CORS allowlist for edge functions (comma-separated).
# Empty = fail-closed defaults (this extension + the OAuth consent page).

CORS_ALLOWED_ORIGINS=
