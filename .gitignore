# @last-edited: 2026-11-13 UTC+7.
# @title: .gitignore - what the repository never tracks, so nothing generated or secret reaches a clone.
# @state: dependencies (node_modules), build output, signing keys, and machine-local state are untracked; package-lock.json is tracked on purpose since 2026-11-13 so every install is byte-identical.
# @dependencies: none stated.

# Dependencies node_modules is regenerable machine state; package-lock.json is the reviewed manifest of what it resolves to and is tracked since 2026-11-13.

node_modules/

# Build output

dist/
build/
coverage/

# document_build writes a checked plan beside its source; the JSON source is what a person authors and commits.

*.document.json

# The spreadsheet and deck writers write their checked plan beside the source too, and the plan carries the moment it was made, so committing it only lets it drift.

*.report.json
*.deck.json

# The store package is generated by scripts/release/build-store-package.py from extension/, so committing it only lets it drift from the extension it copies.
# The manifest beside it IS tracked: scripts/verify/check.mjs asserts it still matches.

docs/store/opera-agent-store.zip

# Environment and secrets

.env
.env.*
!.env.example
*.pem
*.key
*.p12

# A CRX carries a public key and a signature, never the private one, so the artifact is safe to publish.
# No copy is committed: the endpoint serves the signed bytes the release workflow uploaded, and the download page asks it.

*.crx

# Supabase local state

.supabase/
hosted/.temp/

# Local crash-recovery state for the transaction launchers (nonsecret, never commit)

.opera-agent-state/

# Repowise local codebase intelligence (cache + isolated Python environment)

.repowise/
.repowise-venv/

# Spec Kit local isolated Python environment

.spec-kit-venv/

# The proof run writes its own copies beside its record; the same bytes already ship in landing/contoh/.

docs/proof/out/
docs/proof/downloads/

# Editor / OS

.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs

*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary files

.tmp/
tmp/
.vercel

# Python test artifacts

__pycache__/
*.py[cod]

# Local agent-tool state and analysis caches (machine-local, never tracked)

.kilo/
.superpowers/
.agents/
.serena/
.ruff_cache/
skills-lock.json
graphify-out/
.taste-skill/

# The local package's vendored copies are generated by scripts/pack/pack-mcp.mjs at pack time; local/lib/ holds exactly one copy of each shared/extension module, never committed.
# The .d.ts declarations beside the copies ARE tracked on purpose, so tsc can type local/ against them; the .js files never ship in the repository.

local/lib/*
!local/lib/*.d.ts

# The compiled twin of every TypeScript source: written by scripts/pack/build-shared.mjs beside the .ts, never committed; the map gate fails on a tracked .js in a folder that carries .ts.

shared/*.js

# The compiled twin of every TypeScript source: written by scripts/pack/build-local.mjs beside the .ts, never committed; the map gate fails on a tracked .js in a folder that carries .ts.

local/*.js
local/bin/*.js
local/office/*.js

# The compiled twin of every TypeScript source: written by scripts/pack/build-extension.mjs beside the .ts, never committed; the map gate fails on a tracked .js in a folder that carries .ts.

extension/*.js
extension/lib/*.js
extension/worker/*.js
extension/content/*.js
extension-stage


# npm pack output (npm pack ./local writes the tarball beside the package)

*.tgz
