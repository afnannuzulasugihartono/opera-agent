{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opera-agent:transaction:provenance:v1",
  "title": "Opera Agent Action Provenance V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenanceId", "sourceKind", "sourceDigest", "authorityRole", "tenantId", "goalRevision", "freshnessClass", "transformChain", "valueDigest"],
  "properties": {
    "schemaVersion": {"const": "OA_ACTION_PROVENANCE_V1"},
    "provenanceId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "sourceKind": {"enum": ["USER_EXPLICIT", "LEDGER_AUTHORITY", "TRUSTED_POLICY", "SERVER_DERIVED", "BROWSER_OBSERVED", "TOOL_OBSERVED", "MODEL_DERIVED"]},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "authorityRole": {"enum": ["AUTHORITY", "OPERAND", "EVIDENCE", "DISPLAY_ONLY"]},
    "tenantId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "goalRevision": {"type": "integer", "minimum": 1},
    "deviceId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "tabId": {"type": "integer", "minimum": 0},
    "documentGeneration": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "observedAt": {"type": "string", "format": "date-time"},
    "sourceRevision": {"type": "string", "maxLength": 128},
    "freshnessClass": {"enum": ["CURRENT", "BOUNDED_RECENT", "STATIC_TRUSTED", "STALE", "UNKNOWN"]},
    "transformChain": {"type": "array", "maxItems": 8, "items": {"enum": ["IDENTITY", "NORMALIZE_NFC", "TRIM", "LOWERCASE_ASCII", "INTEGER_PARSE", "DECIMAL_TO_MINOR_UNITS", "SELECT_FIELD", "CONCAT_BOUNDED"]}},
    "valueDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "allOf": [
    {
      "if": {"properties": {"authorityRole": {"const": "AUTHORITY"}}, "required": ["authorityRole"]},
      "then": {"properties": {"sourceKind": {"enum": ["USER_EXPLICIT", "LEDGER_AUTHORITY", "TRUSTED_POLICY"]}}}
    }
  ]
}
