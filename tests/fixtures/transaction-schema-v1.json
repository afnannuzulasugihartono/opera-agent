{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opera-agent:transaction:v1",
  "title": "Opera Agent Transaction V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "tenantId", "goalId", "goalRevision", "target", "effectClass", "decisionPredicates", "action", "provenance", "expectedPostconditions", "budgets", "enforcementMode", "preparedAt", "expiresAt", "prepareDigest"],
  "properties": {
    "schemaVersion": {"const": "OA_TRANSACTION_V1"},
    "transactionId": {"$ref": "#/$defs/id"},
    "tenantId": {"$ref": "#/$defs/id"},
    "goalId": {"$ref": "#/$defs/id"},
    "goalRevision": {"type": "integer", "minimum": 1},
    "programDigest": {"$ref": "#/$defs/digest"},
    "vmRunId": {"$ref": "#/$defs/id"},
    "target": {"$ref": "#/$defs/target"},
    "effectClass": {"enum": ["LOCAL_REVERSIBLE", "STAGED_EXTERNAL", "COMPENSABLE_EXTERNAL", "IRREVERSIBLE_OR_UNKNOWN"]},
    "decisionPredicates": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/predicate"}},
    "action": {"$ref": "#/$defs/action"},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "action-provenance-schema-v1.json"}},
    "expectedPostconditions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/digest"}},
    "compensationDescriptorDigest": {"$ref": "#/$defs/digest"},
    "compensatesTransactionId": {"$ref": "#/$defs/id"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "enforcementMode": {"enum": ["OFF", "DARK", "ENFORCED"]},
    "preparedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "prepareDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "tabId", "targetDigest"],
      "properties": {
        "deviceId": {"$ref": "#/$defs/id"},
        "tabId": {"type": "integer", "minimum": 0},
        "documentGeneration": {"$ref": "#/$defs/id"},
        "targetDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicateId", "kind", "dependencyDigests"],
      "properties": {
        "predicateId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["AUTHORITY", "USER_IDENTITY", "OAUTH_CLIENT_IDENTITY", "GOAL_REVISION", "TARGET", "DOCUMENT_GENERATION", "ACTION", "OPERAND", "EFFECT_CLASS", "ENFORCEMENT_MODE", "APPROVAL", "SENSITIVE_POLICY", "POSTCONDITION"]},
        "dependencyDigests": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/digest"}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptorId", "method", "argumentsDigest", "actionDigest"],
      "properties": {
        "descriptorId": {"$ref": "#/$defs/id"},
        "method": {"enum": ["tabs.open", "tabs.activate", "tabs.close", "tabs.navigate", "tabs.reload", "page.click", "page.pointer", "page.fill", "page.focus", "page.scroll", "page.key", "media.play", "media.pause", "media.seek"]},
        "argumentsDigest": {"$ref": "#/$defs/digest"},
        "actionDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serializedProposalBytes", "preparedTransactionBytes", "receiptBytes", "stateChangingActionsPerTransaction", "consequentialActionsPerTransaction", "irreversibleOrUnknownActionsPerTransaction", "decisionPredicates", "provenanceRecords", "transformChainDepth", "expectedPostconditions", "approvalPreviewBytes", "approvalMrtrRounds", "prepareLifetimeMs", "approvalLifetimeMs", "approvalToDispatchMs", "finalValidationToDispatchMs", "commitCommandTimeoutMs", "postCommitObservationAttempts", "postCommitObserveVerifyMs", "concurrentCommitPerTargetTab", "concurrentCommittingPerTenant", "pendingPerTenant", "prepareRatePerTenantPerMinute", "commitRatePerTenantPerMinute", "totalTransactionLifetimeMs", "activeCompensationsPerOriginal", "nonterminalRetentionHours", "terminalRetentionDays"],
      "properties": {
        "serializedProposalBytes": {"type":"integer","minimum":1,"maximum":65536},
        "preparedTransactionBytes": {"type":"integer","minimum":1,"maximum":131072},
        "receiptBytes": {"type":"integer","minimum":1,"maximum":65536},
        "stateChangingActionsPerTransaction": {"const":1},
        "consequentialActionsPerTransaction": {"const":1},
        "irreversibleOrUnknownActionsPerTransaction": {"const":1},
        "decisionPredicates": {"type":"integer","minimum":1,"maximum":64},
        "provenanceRecords": {"type":"integer","minimum":1,"maximum":128},
        "transformChainDepth": {"type":"integer","minimum":1,"maximum":8},
        "expectedPostconditions": {"type":"integer","minimum":1,"maximum":64},
        "approvalPreviewBytes": {"type":"integer","minimum":1,"maximum":16384},
        "approvalMrtrRounds": {"const":1},
        "prepareLifetimeMs": {"type":"integer","minimum":1,"maximum":600000},
        "approvalLifetimeMs": {"type":"integer","minimum":1,"maximum":120000},
        "approvalToDispatchMs": {"type":"integer","minimum":1,"maximum":15000},
        "finalValidationToDispatchMs": {"type":"integer","minimum":1,"maximum":5000},
        "commitCommandTimeoutMs": {"type":"integer","minimum":1,"maximum":30000},
        "postCommitObservationAttempts": {"type":"integer","minimum":1,"maximum":3},
        "postCommitObserveVerifyMs": {"type":"integer","minimum":1,"maximum":30000},
        "concurrentCommitPerTargetTab": {"const":1},
        "concurrentCommittingPerTenant": {"type":"integer","minimum":1,"maximum":2},
        "pendingPerTenant": {"type":"integer","minimum":1,"maximum":8},
        "prepareRatePerTenantPerMinute": {"type":"integer","minimum":1,"maximum":20},
        "commitRatePerTenantPerMinute": {"type":"integer","minimum":1,"maximum":10},
        "totalTransactionLifetimeMs": {"type":"integer","minimum":1,"maximum":600000},
        "activeCompensationsPerOriginal": {"const":1},
        "nonterminalRetentionHours": {"type":"integer","minimum":1,"maximum":24},
        "terminalRetentionDays": {"type":"integer","minimum":1,"maximum":7}
      }
    }
  }
}
