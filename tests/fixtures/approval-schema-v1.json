{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opera-agent:transaction:approval:v1",
  "title": "Opera Agent Transaction Approval V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvalChallengeId", "authenticatedUserId", "authenticatedOAuthClientId", "tenantId", "transactionId", "goalRevision", "prepareDigest", "previewDigest", "targetDigest", "effectClass", "nonceDigest", "issuedAt", "expiresAt", "protocolEra", "approvalDigest"],
  "properties": {
    "schemaVersion": {"const": "OA_APPROVAL_V1"},
    "approvalChallengeId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "authenticatedUserId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "authenticatedOAuthClientId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "tenantId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "transactionId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "goalRevision": {"type": "integer", "minimum": 1},
    "prepareDigest": {"$ref": "#/$defs/digest"},
    "previewDigest": {"$ref": "#/$defs/digest"},
    "targetDigest": {"$ref": "#/$defs/digest"},
    "effectClass": {"enum": ["LOCAL_REVERSIBLE", "STAGED_EXTERNAL", "COMPENSABLE_EXTERNAL", "IRREVERSIBLE_OR_UNKNOWN"]},
    "nonceDigest": {"$ref": "#/$defs/digest"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "protocolEra": {"enum": ["MCP_2026_07_28", "MCP_2025_LEGACY"]},
    "approvalDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
