{
  "manifest_version": 3,
  "name": "Opera Agent",
  "version": "1.6.27",
  "description": "Private local Opera bridge for secure browser control through Supabase workflows.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/agent-log.js",
        "semantic-identity.js",
        "semantic-views.js",
        "role-reconcile.js",
        "hover-settle.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Opera Agent",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://localhost/*",
      "https://opera-agent.pages.dev/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://*.supabase.co wss://*.supabase.co https:"
  },
  "key": "",
  "update_url": "https://nenmkmtvjremqphfqnfw.supabase.co/functions/v1/opera-agent-update/update.xml"
}
