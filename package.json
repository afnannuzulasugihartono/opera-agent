{
  "name": "opera-agent",
  "version": "1.6.20",
  "private": true,
  "license": "MIT",
  "description": "Local Opera browser control bridge with Supabase-powered workflows and automation.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/protocol.test.mjs tests/workflow-dsl.test.mjs",
    "test:browser": "python tests/browser_extension_test.py",
    "benchmark:semantic": "node scripts/semantic-baseline.mjs --runs=3",
    "benchmark:ledger": "node scripts/goal-ledger-benchmark.mjs --runs=3 --iterations=1000",
    "benchmark:proof": "node scripts/proof-engine-benchmark.mjs --runs=30",
    "check": "node scripts/check.mjs",
    "scope": "node scripts/scope.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
