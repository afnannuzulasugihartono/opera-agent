{
  "name": "opera-agent",
  "version": "1.6.51",
  "private": true,
  "license": "MIT",
  "description": "Local Opera browser control bridge with Supabase-powered workflows and automation.",
  "type": "module",
  "scripts": {
    "build:shared": "node scripts/pack/build-shared.mjs",
    "build:local": "node scripts/pack/build-local.mjs",
    "build:extension": "node scripts/pack/build-extension.mjs",
    "build:extension:watch": "tsc -p tsconfig.extension.json --watch",
    "types": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.local.json && tsc --noEmit -p tsconfig.extension.json",
    "pretest": "npm run audit && npm run biome && npm run build:shared && npm run build:local && npm run build:extension && node scripts/pack/pack-mcp.mjs",
    "audit": "node scripts/audit/audit-cheats.mjs",
    "biome": "biome check .",
    "test": "node --test --test-timeout=120000 --test-reporter=dot tests/**/*.test.mjs",
    "test:unit": "node --test tests/extension/protocol.test.mjs tests/vm/workflow-dsl.test.mjs",
    "test:browser": "python tests/browser_extension_test.py",
    "benchmark:semantic": "node scripts/verify/semantic-baseline.mjs --runs=3",
    "benchmark:ledger": "node scripts/bench/goal-ledger-benchmark.mjs --runs=3 --iterations=1000",
    "benchmark:proof": "node scripts/bench/proof-engine-benchmark.mjs --runs=30",
    "benchmark:latency": "node scripts/bench/latency-benchmark.mjs --runs=30",
    "bridge": "node scripts/dev/start-bridge.mjs",
    "diagnose:mcp": "node scripts/dev/mcp-connection-diagnostics.mjs",
    "migrate": "node scripts/release/apply-migrations.mjs",
    "store": "python scripts/release/build-store-package.py",
    "icons": "python scripts/dev/draw-icon.py",
    "gates:refresh": "node scripts/verify/gates.mjs --refresh",
    "check": "node scripts/verify/check.mjs",
    "scope": "node scripts/verify/scope.mjs",
    "scope:diff": "node scripts/verify/scope-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
